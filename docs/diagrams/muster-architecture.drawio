<mxfile host="app.diagrams.net" type="device">
  <diagram id="how-it-works" name="How it works">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Muster — an autonomous shift coordinator that knows the law" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#161a25;" vertex="1" parent="1"><mxGeometry x="60" y="34" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="tsub" value="A shift loses its worker. Four cities price that differently. Muster does the arithmetic, and stops at the line it may not cross." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="60" y="68" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="s1" value="A shift loses&lt;br&gt;its worker" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4429c4;strokeColor=#2f1b7a;fontSize=15;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="s2" value="Muster finds every&lt;br&gt;lawful cover and&lt;br&gt;prices each one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=15;fontColor=#161a25;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="195" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="s3" value="The law&lt;br&gt;4 city rulebooks, as data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;strokeWidth=2;fontSize=15;fontColor=#2f1b7a;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="360" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="s4" value="Is it inside the&lt;br&gt;limits you set?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;strokeWidth=2;fontSize=15;fontColor=#2f1b7a;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="550" y="200" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="o1" value="Yes — it does it&lt;br&gt;and writes a receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#12734a;strokeWidth=2;fontSize=15;fontColor=#0d5c3a;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="o2" value="No — it asks you&lt;br&gt;cost, overtime, hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=15;fontColor=#161a25;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="205" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="o3" value="Only the worker can say yes&lt;br&gt;a rest-period waiver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;strokeWidth=2;fontSize=15;fontColor=#2f1b7a;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="820" y="310" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="p1" value="Operator" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4429c4;strokeColor=#2f1b7a;fontSize=15;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="210" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="p2" value="Worker" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4429c4;strokeColor=#2f1b7a;fontSize=15;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="315" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="r1" value="Receipt&lt;br&gt;the clause, the money,&lt;br&gt;who decided" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#12734a;strokeWidth=2;fontSize=15;fontColor=#0d5c3a;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="1130" y="95" width="150" height="90" as="geometry"/></mxCell>
        <mxCell id="k1" value="Every figure comes from the city's own .gov page." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="270" y="438" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="k2" value="Two rules no setting can move: Muster never waives a worker's rest period on their behalf, and never asks someone who has already said no." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="550" y="478" width="420" height="44" as="geometry"/></mxCell>
        <mxCell id="k3" value="Nothing is committed before it stops — a held decision leaves the receipts empty." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="990" y="478" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="g8" value="BUILT WITH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#e3e6ec;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#5a6273;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1180" height="130" as="geometry"/></mxCell>
        <mxCell id="d1" value="Strands Agents&lt;br&gt;two loops, and the autonomy&lt;br&gt;boundary as executable code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;strokeWidth=2;fontSize=15;fontColor=#2f1b7a;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="84" y="596" width="270" height="72" as="geometry"/></mxCell>
        <mxCell id="d2" value="Amazon Bedrock&lt;br&gt;Claude Sonnet reasons.&lt;br&gt;It never does the arithmetic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;strokeWidth=2;fontSize=15;fontColor=#2f1b7a;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="374" y="596" width="270" height="72" as="geometry"/></mxCell>
        <mxCell id="d3" value="AWS App Runner&lt;br&gt;one container: agent,&lt;br&gt;API and console" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=15;fontColor=#161a25;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="664" y="596" width="250" height="72" as="geometry"/></mxCell>
        <mxCell id="d4" value="An MCP server&lt;br&gt;read-only over the same&lt;br&gt;engine. It cannot change a week." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=15;fontColor=#161a25;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="934" y="596" width="280" height="72" as="geometry"/></mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a6273;strokeWidth=2;fontSize=13;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="prices from" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a6273;strokeWidth=2;fontSize=13;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a6273;strokeWidth=2;fontSize=13;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4429c4;strokeWidth=2;fontSize=13;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a6273;strokeWidth=2;fontSize=13;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4429c4;strokeWidth=2;fontSize=13;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4429c4;strokeWidth=2;fontSize=13;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5a6273;strokeWidth=2;fontSize=13;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o2" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4429c4;strokeWidth=2;fontSize=13;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o3" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a10" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4429c4;strokeWidth=2;fontSize=13;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a11" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4429c4;strokeWidth=2;fontSize=13;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="under-the-hood" name="Under the hood">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="One guarded tool call, end to end" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#161a25;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="n0" value="The two places a person is asked, and why they are different people." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="700" height="20" as="geometry"/></mxCell>
        <mxCell id="d_in" value="A shift loses&lt;br&gt;its worker" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4429c4;strokeColor=#2f1b7a;fontSize=11;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="120" height="56" as="geometry"/></mxCell>
        <mxCell id="d_hold" value="HOLD loop&lt;br&gt;lists every lawful cover,&lt;br&gt;each priced from the&lt;br&gt;governing ordinance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=11;fontColor=#161a25;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="118" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="d_prop" value="proposes&lt;br&gt;assign_cover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;fontSize=11;fontColor=#2f1b7a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="410" y="132" width="120" height="52" as="geometry"/></mxCell>
        <mxCell id="d_g1" value="1 · PostingDependencyGuard&lt;br&gt;is this week posted, and is&lt;br&gt;there an approved cover behind it?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=11;fontColor=#161a25;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="112" width="210" height="72" as="geometry"/></mxCell>
        <mxCell id="d_deny" value="Deny&lt;br&gt;never reaches the world" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#b42318;fontSize=11;fontColor=#912018;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="118" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="d_g2" value="2 · EscalationPolicy&lt;br&gt;may it act alone at&lt;br&gt;this autonomy level?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;fontSize=11;fontColor=#2f1b7a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="240" width="210" height="72" as="geometry"/></mxCell>
        <mxCell id="d_ok" value="Proceed&lt;br&gt;within limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#12734a;fontSize=11;fontColor=#0d5c3a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="246" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="d_commit" value="Commit + receipt&lt;br&gt;clause · money · carve-out&lt;br&gt;consent · who decided" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#12734a;fontSize=11;fontColor=#0d5c3a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="236" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="d_conf" value="Confirm&lt;br&gt;snapshot the run and stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;fontSize=11;fontColor=#2f1b7a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="372" width="210" height="56" as="geometry"/></mxCell>
        <mxCell id="d_inbox" value="Decision inbox&lt;br&gt;the question, and the&lt;br&gt;whole agent state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cede;fontSize=11;fontColor=#161a25;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="456" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="d_op" value="Operator" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4429c4;strokeColor=#2f1b7a;fontSize=11;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="560" width="130" height="50" as="geometry"/></mxCell>
        <mxCell id="d_appr" value="Approve&lt;br&gt;the same run resumes, hours later,&lt;br&gt;on another machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#12734a;fontSize=11;fontColor=#0d5c3a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="540" width="200" height="72" as="geometry"/></mxCell>
        <mxCell id="d_decl" value="Decline&lt;br&gt;nothing is handed back to the agent;&lt;br&gt;the shift stays open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#b42318;fontSize=11;fontColor=#912018;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="640" width="200" height="72" as="geometry"/></mxCell>
        <mxCell id="d_rest" value="requires a rest-period waiver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;fontSize=11;fontColor=#2f1b7a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="300" width="170" height="34" as="geometry"/></mxCell>
        <mxCell id="d_ask" value="request_consent&lt;br&gt;the ask, never the waiver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efeaff;strokeColor=#4429c4;fontSize=11;fontColor=#2f1b7a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="350" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="d_worker" value="Worker" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4429c4;strokeColor=#2f1b7a;fontSize=11;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="452" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="d_yes" value="Yes&lt;br&gt;the waiver is satisfied;&lt;br&gt;what is left is the money" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eefaf3;strokeColor=#12734a;fontSize=11;fontColor=#0d5c3a;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="428" width="170" height="62" as="geometry"/></mxCell>
        <mxCell id="d_no" value="No&lt;br&gt;final — Muster asks&lt;br&gt;someone else, never her again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#b42318;fontSize=11;fontColor=#912018;arcSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="200" y="508" width="170" height="62" as="geometry"/></mxCell>
        <mxCell id="d_note1" value="Two rules fire at every autonomy level, the most permissive included: Muster will never waive a worker's rest period on their behalf, and never asks someone who has already declined. Oregon requires the worker's own consent, NYC requires it in writing, and Chicago's guidance says the Right to Rest has no exceptions. An agent that could dial past those would not be more capable — it would be unlawful." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="1250" y="100" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="d_note2" value="Nothing is committed before the pause. A held decision leaves Receipts empty — it stopped before it did anything, not after." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5a6273;" vertex="1" parent="1"><mxGeometry x="1250" y="250" width="280" height="60" as="geometry"/></mxCell>
        <mxCell id="b1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_in" target="d_hold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b2" value="cheapest lawful" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_hold" target="d_prop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_prop" target="d_g1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b4" value="Deny" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#b42318;fontSize=10;fontColor=#b42318;endArrow=blockThin;endFill=1;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_g1" target="d_deny"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b5" value="Proceed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_g1" target="d_g2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b6" value="no rule fires" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_g2" target="d_ok"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_ok" target="d_commit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b8" value="a rule fires" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#4429c4;strokeWidth=2;fontSize=10;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="d_g2" target="d_conf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#4429c4;strokeWidth=2;fontSize=10;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="d_conf" target="d_inbox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b10" value="surfaced on Decisions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#5a6273;fontSize=10;fontColor=#5a6273;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d_inbox" target="d_op"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;strokeColor=#4429c4;strokeWidth=2;fontSize=10;fontColor=#4429c4;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="d_op" target="d_appr"><mxGeometry relative="1" as="geometry"/></mxCell>
